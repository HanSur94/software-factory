{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan/1",
  "description": "YAML front matter of plan.md, written by the planner. The Markdown body below it is the rationale for a human reader.",
  "type": "object",
  "required": [
    "schema",
    "ticket",
    "summary",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "plan/1"
    },
    "ticket": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]+$"
            }
          },
          "estimated_lines": {
            "type": "integer",
            "minimum": 0,
            "description": "The planner's estimate of the lines this task changes, tests included, generated files left out."
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Choices made instead of asking the owner (pipeline.questions: assume); shown in the pull request."
    }
  }
}

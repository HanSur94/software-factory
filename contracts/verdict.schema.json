{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verdict/1",
  "description": "The only thing that leaves the judge job: a value and the failure picture, never the scenario text.",
  "type": "object",
  "required": ["schema", "ticket", "commit", "scenarios_total", "scenarios_passed", "satisfaction", "threshold", "passed", "failures"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "verdict/1" },
    "ticket": { "type": "integer", "minimum": 1 },
    "commit": { "type": "string" },
    "scenarios_total": { "type": "integer", "minimum": 0 },
    "scenarios_passed": { "type": "integer", "minimum": 0 },
    "satisfaction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "passed": { "type": ["boolean", "null"] },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "symptom"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "symptom": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "duration_s": { "type": "number", "minimum": 0 },
    "model": { "type": "string" },
    "skills_offered": { "type": "array", "items": { "type": "string" } },
    "skills_used": { "type": "array", "items": { "type": "string" } },
    "turns": { "type": "integer", "minimum": 0 },
    "tools": { "description": "Tool names and counts only; what the judge did with them stays in its job.", "type": "object", "additionalProperties": { "type": "integer" } },
    "runtime": { "type": "object" },
    "tokens": { "description": "input, output, cache_read, cache_write", "type": "object", "additionalProperties": { "type": "integer" } },
    "context_peak": { "description": "Most tokens in the context window at any point of the run.", "type": "integer" },
    "context_window": { "type": "integer" },
    "subscription": { "description": "Per limit window of the Claude plan: share used at start and end of the run.", "type": "object" }
  }
}
